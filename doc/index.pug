doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='theme-color' content='#1a2a33')
    link(rel='icon' type='image/png' sizes='32x32' href='./images/favicon-32x32.png')
    link(rel='stylesheet' href='./css/style.css')
    title Frontend Mentor | Tic Tac Toe
  body
    a.c-skip-link(href='#main-content') Skip to main content

    main#main-content.l-cover
      div.center.l-center
        div.c-app.l-stack(data-space='large')
          section.c-new-game.l-stack(data-space='normal' aria-labelledby='new-game-title')
            img.c-new-game__logo(src='./images/logo.svg' alt='Tic Tac Toe')
            h1#new-game-title Pick player 1's mark

            div.c-mark-picker.l-cluster(data-gap='small' role='group' aria-labelledby='new-game-title')
              button.c-mark-picker__choice(type='button' aria-label='X' aria-pressed='false')
                img(src='./images/icon-x.svg' alt='')
              button.c-mark-picker__choice.is-selected(type='button' aria-label='O' aria-pressed='true')
                img(src='./images/icon-o.svg' alt='')

            p.c-new-game__hint Remember: X goes first
            div.c-new-game__actions.l-stack(data-space='small')
              button.c-button.c-button--secondary(type='button') New Game (vs player)
              button.c-button.c-button--primary(type='button') New Game (vs CPU)

          section.c-game-board(aria-label='Game board' hidden)
            header.c-game-board__header.l-cluster(data-justify='between')
              img(src='./images/logo.svg' alt='Tic Tac Toe')
              p.c-turn-indicator
                img(src='./images/icon-x.svg' alt='')
                span Turn
              button.c-button.c-restart(type='button' aria-label='Restart game')
                img(src='./images/icon-restart.svg' alt='')

            div.c-board(role='grid' aria-label='Tic Tac Toe board')
              each cell, index in [1, 2, 3, 4, 5, 6, 7, 8, 9]
                button.c-board__cell(type='button' role='gridcell' aria-label='Empty square ' + (index + 1))

            section.c-scores.l-cluster(data-gap='small' aria-label='Score')
              div.c-score.l-stack(data-space='small')
                span.c-score__label X (You)
                output.c-score__value 0
              div.c-score.l-stack(data-space='small')
                span.c-score__label Ties
                output.c-score__value 0
              div.c-score.l-stack(data-space='small')
                span.c-score__label X (CPU)
                output.c-score__value 0

          section.c-round-result.l-stack(data-space='small' aria-live='assertive' hidden)
            p.c-round-result__message Oh no, you lost
            p.c-round-result__message You won!
            p.c-round-result__message Player 1 wins!
            p.c-round-result__winner
              img(src='./images/icon-o.svg' alt='')
              span takes the round
            p.c-round-result__tie Round tied
            div.c-round-result__actions.l-cluster(data-gap='small')
              button.c-button(type='button') Quit
              button.c-button.c-button--primary(type='button') Next round

          section.c-restart-dialog.l-stack(data-space='normal' role='dialog' aria-modal='true' aria-labelledby='restart-title' hidden)
            h2#restart-title Restart game?
            div.c-restart-dialog__actions.l-cluster(data-gap='small')
              button.c-button(type='button') No, cancel
              button.c-button.c-button--primary(type='button') Yes, restart

    script(src='./js/main.js' defer)